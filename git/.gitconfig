[alias]
	ac = "!f() { \
		git diff --cached --quiet && { git add -A || return; }; \
		case \"$1\" in \
			-e) shift; git commit --amend \"$@\";; \
			-n) shift; git commit \"$@\";; \
			*) git commit --amend --no-edit \"$@\";; \
		esac; \
	}; f"
	acp = "!f() { \
		git ac \"$@\" && git push --force-with-lease --force-if-includes; \
	}; f"

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = github.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = github.gitconfig
